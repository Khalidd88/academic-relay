# ==============================================
# UEU Academic Radar - Environment Configuration
# ==============================================

NODE_ENV=development
PORT=4000
TZ=Asia/Jakarta

# ----------------------------------------------
# Frontend & Bot Configuration
# ----------------------------------------------
FRONTEND_URL=http://localhost:3000
WA_BOT_NUMBER=6281234567890

# ----------------------------------------------
# Admin Security
# ----------------------------------------------
ADMIN_SECRET=ueu-radar-super-secret-admin-key-2026

# ----------------------------------------------
# Database (PostgreSQL 16)
# ----------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=ueu_academic_radar
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/ueu_academic_radar?schema=public"

# ----------------------------------------------
# Redis 7 (BullMQ & Cache)
# ----------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# ----------------------------------------------
# Notification Channel Configuration
# ----------------------------------------------
# Options: "TELEGRAM" | "WAHA"
NOTIFY_CHANNEL=TELEGRAM
TELEGRAM_BOT_TOKEN=9243164980:AAF65dbTr0ct12MxKHgPuWohgQAvi9dpdGY
TELEGRAM_TEST_CHAT_ID=5428307508

# ----------------------------------------------
# WhatsApp HTTP API (WAHA)
# ----------------------------------------------
WAHA_BASE_URL=http://127.0.0.1:3005
WAHA_SESSION=default
WAHA_API_KEY=ueu_waha_secret_key_2026

# ----------------------------------------------
# Application Security
# ----------------------------------------------
# 32-byte key for AES-256-GCM & HMAC
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
